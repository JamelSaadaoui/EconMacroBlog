. * ----------------------------------------------------------------------
. * Pooled estimator: country-demeaned system
. * ----------------------------------------------------------------------
. 
. sort country_id year

. 
. foreach v of local yraw {
  2.     by country_id: egen mean_`v'_f9 = ///
>         mean(cond(sample_f9, `v', .))
  3.     gen dm_`v'_f9 = ///
>         cond(sample_f9, `v' - mean_`v'_f9, .)
  4. }
(537 missing values generated)
(537 missing values generated)
(537 missing values generated)
